<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\b-Code-HistoryMinerva\build\HistoryMinerva.Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="HistoryMinervaRepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\b-Code-HistoryMinerva\src\HistoryMinerva\HistoryMinerva.csproj" />
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Services">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Services.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Shell">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Shell.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AvalonDock">
      <HintPath>$(HistoryVulcanHostRoot)\AvalonDock.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AvalonDock.Themes.VS2013">
      <HintPath>$(HistoryVulcanHostRoot)\AvalonDock.Themes.VS2013.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RefreshHistoryVulcanUiTestRuntime" AfterTargets="Build">
    <ItemGroup>
      <HistoryVulcanUiTestRuntime Include="$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryVulcanHostRoot)\HistoryVulcan.Services.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryVulcanHostRoot)\HistoryVulcan.Shell.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryVulcanHostRoot)\HistoryVulcan.Extensibility.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryVulcanHostRoot)\AvalonDock.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryVulcanHostRoot)\AvalonDock.Themes.VS2013.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(HistoryVulcanUiTestRuntime)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
