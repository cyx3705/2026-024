<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\b-Code-HistoryMinerva\build\HistoryMinerva.Version.props" />
  <PropertyGroup>
    <!--
      Exe 而不是 WinExe：这是个门禁工具，成功要打印一行 PASS、失败要打印原因。
      WinExe 没有控制台，「跑过了」与「根本没跑」在终端上长得一模一样（V4.10.2）。
      WPF 在 Exe 下照常工作，入口仍是 [STAThread]。
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <HistoryClioRoot Condition="'$(HistoryClioRoot)' == ''">$([System.IO.Path]::GetFullPath('$(HistoryVulcanPackageRoot)\..\..'))</HistoryClioRoot>
    <HistoryAuroraRuntimeRoot Condition="'$(HistoryAuroraRuntimeRoot)' == ''">$(HistoryClioRoot)\2026-026-HistoryAurora\b-Code-Studio\Module\bin\Release\net8.0-windows</HistoryAuroraRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="HistoryMinervaRepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\b-Code-HistoryMinerva\src\HistoryMinerva\HistoryMinerva.csproj" />
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="HistoryVulcan.Services">
      <HintPath>$(HistoryVulcanHostRoot)\HistoryVulcan.Services.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="HistoryAurora">
      <HintPath>$(HistoryAuroraRuntimeRoot)\HistoryAurora.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AvalonDock">
      <HintPath>$(HistoryAuroraRuntimeRoot)\AvalonDock.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AvalonDock.Themes.VS2013">
      <HintPath>$(HistoryAuroraRuntimeRoot)\AvalonDock.Themes.VS2013.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateHistoryAuroraUiTestRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(HistoryAuroraRuntimeRoot)\HistoryAurora.dll')"
           Text="HistoryAurora UI Smoke runtime not found: $(HistoryAuroraRuntimeRoot)\HistoryAurora.dll" />
  </Target>
  <Target Name="RefreshHistoryVulcanUiTestRuntime" AfterTargets="Build">
    <ItemGroup>
      <HistoryVulcanUiTestRuntime Include="$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryVulcanHostRoot)\HistoryVulcan.Services.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryAuroraRuntimeRoot)\HistoryAurora.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryAuroraRuntimeRoot)\AvalonDock.dll" />
      <HistoryVulcanUiTestRuntime Include="$(HistoryAuroraRuntimeRoot)\AvalonDock.Themes.VS2013.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(HistoryVulcanUiTestRuntime)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
