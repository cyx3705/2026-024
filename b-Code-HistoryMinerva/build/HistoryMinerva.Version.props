<Project>
  <!-- 唯一可编辑的发布版本源。改这里，manifest 与程序集版本一起走。 -->
  <PropertyGroup>
    <HistoryMinervaVersion>4.3.19</HistoryMinervaVersion>
    <MinimumHistoryVulcanVersion>3.11.1</MinimumHistoryVulcanVersion>
    <HistoryVulcanPublishRoot Condition="'$(HistoryVulcanPublishRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\2026-023-HistoryVulcan\z-Publish</HistoryVulcanPublishRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(HistoryVulcanPackageRoot)' == ''">
    <_HistoryVulcanVersionedManifest Include="$(HistoryVulcanPublishRoot)\HistoryVulcan-v*\manifest.json" />
  </ItemGroup>
  <PropertyGroup>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == '' and Exists('$(HistoryVulcanPublishRoot)\manifest.json')">$(HistoryVulcanPublishRoot)</HistoryVulcanPackageRoot>
    <HistoryVulcanPackageRoot Condition="'$(HistoryVulcanPackageRoot)' == '' and '@(_HistoryVulcanVersionedManifest)' != ''">@(_HistoryVulcanVersionedManifest->'%(RootDir)%(Directory)')</HistoryVulcanPackageRoot>
    <HistoryVulcanHostRoot Condition="'$(HistoryVulcanHostRoot)' == ''">$(HistoryVulcanPackageRoot)\host</HistoryVulcanHostRoot>
    <HistoryVulcanManifestPath>$(HistoryVulcanPackageRoot)\manifest.json</HistoryVulcanManifestPath>
    <HistoryVulcanCorePath>$(HistoryVulcanHostRoot)\HistoryVulcan.Core.dll</HistoryVulcanCorePath>
    <Version>$(HistoryMinervaVersion)</Version>
    <AssemblyVersion>$(HistoryMinervaVersion).0</AssemblyVersion>
    <FileVersion>$(HistoryMinervaVersion).0</FileVersion>
    <InformationalVersion>$(HistoryMinervaVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
