<UserControl x:Class="HistoryMinerva.AssemblyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HistoryMinerva"
             MinWidth="320"
             MinHeight="320"
             Background="Transparent"
             FontFamily="{DynamicResource Aurora.Font.Family}"
             FontSize="{DynamicResource Aurora.Font.Body}"
             Foreground="{DynamicResource Aurora.Brush.TextPrimary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Mapping.DataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Aurora.Brush.SurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Aurora.Brush.TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Aurora.Brush.Hairline}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontFamily" Value="{DynamicResource Aurora.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Aurora.Font.Body}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="{DynamicResource Aurora.Space.ControlPad}" />
            <Setter Property="MinHeight" Value="{DynamicResource Aurora.Size.Control}" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:AssemblyTreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding SourcePath}">
                <TextBlock Style="{DynamicResource Aurora.Text.Body}"
                           Text="{Binding DisplayName}"
                           FontWeight="SemiBold" />
                <TextBlock Style="{DynamicResource Aurora.Text.Caption}"
                           Text="{Binding StateText, StringFormat=  · {0}}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="OutputPathBar"
                Grid.Row="0"
                Margin="{DynamicResource Aurora.Space.PadTight}"
                MinHeight="{DynamicResource Aurora.Size.Tab}"
                Background="{DynamicResource Aurora.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SourceColumn" Width="*" />
                    <ColumnDefinition x:Name="ContentColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SourceSelectorButton"
                        Padding="{DynamicResource Aurora.Space.ControlPad}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        Click="OnChooseSourceClick"
                        ToolTip="点击选择装配体或零件文件夹">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="取消当前操作"
                                      Click="OnCancelClick"
                                      IsEnabled="{Binding CanCancel}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SourceLabelText"
                                   Style="{DynamicResource Aurora.Text.Body}"
                                   FontWeight="SemiBold"
                                   Text="{Binding SourceLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SourcePathText"
                                   Grid.Column="1"
                                   Style="{DynamicResource Aurora.Text.Body}"
                                   Margin="{DynamicResource Aurora.Space.Gap}"
                                   Text="{Binding SourcePath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SourcePath}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Border Grid.Column="1"
                        Padding="{DynamicResource Aurora.Space.ControlPad}"
                        BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ContentLabelText"
                                   Style="{DynamicResource Aurora.Text.Body}"
                                   FontWeight="SemiBold"
                                   Text="转换内容"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="MappingContentSelector"
                                  Grid.Column="1"
                                  Margin="{DynamicResource Aurora.Space.Gap}"
                                  ItemsSource="{Binding MappingContents}"
                                  SelectedItem="{Binding SelectedMappingContent, Mode=OneWay}"
                                  DropDownOpened="OnMappingContentDropDownOpened"
                                  DropDownClosed="OnMappingContentDropDownClosed"
                                  SelectionChanged="OnMappingContentSelectionChanged"
                                  ToolTip="选择来源内容与目标文件类型"
                                  IsEnabled="{Binding CanEdit}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <ProgressBar x:Name="OutputActivityBar"
                             Grid.ColumnSpan="2"
                             Height="3"
                             VerticalAlignment="Bottom"
                             IsIndeterminate="True"
                             Background="{DynamicResource Aurora.Brush.Hairline}"
                             Foreground="{DynamicResource Aurora.Brush.Accent}"
                             IsHitTestVisible="False">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>

        <Grid x:Name="PartsHost" Grid.Row="1" Margin="{DynamicResource Aurora.Space.PadTight}">
            <Border Background="{DynamicResource Aurora.Brush.Surface}"
                    BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Aurora.Radius.Inner}">
                <DataGrid x:Name="PartsDataGrid"
                          ItemsSource="{Binding Parts}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Background="{DynamicResource Aurora.Brush.Surface}"
                          Foreground="{DynamicResource Aurora.Brush.TextPrimary}"
                          RowBackground="{DynamicResource Aurora.Brush.Surface}"
                          AlternatingRowBackground="{DynamicResource Aurora.Brush.SurfaceAlt}"
                          HorizontalGridLinesBrush="{DynamicResource Aurora.Brush.Hairline}"
                          BorderThickness="0"
                          RowHeight="32"
                          ColumnHeaderHeight="28"
                          ColumnHeaderStyle="{StaticResource Mapping.DataGridHeader}">
                    <DataGrid.Columns>
                        <!-- 列头跟着源格式走：SW 自整备模式下写死"Solid Edge 零件"是假话。
                             DataGridColumn 不在可视树里，Binding 和 RelativeSource 都解析不到
                             DataContext（试过，列头会变成空白），只能由代码后置赋值。 -->
                        <!-- 属性整备下 DisplayName 给的是改完之后的文件名，因此不再有
                             单独的"改名后预览"列：同一个东西占两列，而改名成功以后
                             "文件"那一列显示的还是一个已经不存在的文件。 -->
                        <DataGridTextColumn x:Name="SourcePartColumn"
                                            Binding="{Binding DisplayName}" Width="2*" MinWidth="120" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="72" />
                        <DataGridTextColumn x:Name="FeatureColumn"
                                            Header="特征" Binding="{Binding FeatureText}" Width="58" />
                        <DataGridTextColumn x:Name="SketchColumn"
                                            Header="草图" Binding="{Binding SketchText}" Width="58" />
                        <DataGridTextColumn x:Name="ResultColumn"
                                            Header="结果" Binding="{Binding Detail}" Width="2.4*" MinWidth="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border x:Name="AssemblyTreeFlyout"
                    HorizontalAlignment="Left"
                    Width="220"
                    Visibility="Collapsed"
                    Background="{DynamicResource Aurora.Brush.Surface}"
                    BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Aurora.Radius.Inner}"
                    Effect="{DynamicResource Aurora.Shadow.Flyout}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="{DynamicResource Aurora.Space.PadTight}"
                            Background="{DynamicResource Aurora.Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Aurora.Brush.Hairline}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Style="{DynamicResource Aurora.Text.Body}"
                                   Text="装配结构"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TreeView x:Name="AssemblyTreeView"
                              ItemsSource="{Binding AssemblyTree}"
                              Padding="{DynamicResource Aurora.Space.PadTight}"
                              Background="Transparent"
                              Foreground="{DynamicResource Aurora.Brush.TextPrimary}"
                              BorderThickness="0" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid x:Name="OptionsActionBar"
              Grid.Row="2"
              Margin="{DynamicResource Aurora.Space.PadTight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel x:Name="OptionsList"
                       Orientation="Horizontal"
                       VerticalAlignment="Center">
                <Grid VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPartDirectoryMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Button x:Name="AssemblyTreeOpenButton"
                            MinWidth="64"
                            MinHeight="{DynamicResource Aurora.Size.Control}"
                            Margin="{DynamicResource Aurora.Space.Gap}"
                            Content="打开"
                            Click="OnAssemblyTreeOpenClick"
                            VerticalAlignment="Center"
                            ToolTip="从左侧打开装配结构" />
                </Grid>
                <Grid VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowConversionOptions}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBlock x:Name="OptionsLabelText"
                               Style="{DynamicResource Aurora.Text.Body}"
                               FontWeight="SemiBold"
                               Margin="{DynamicResource Aurora.Space.Gap}"
                               Text="转换选项"
                               VerticalAlignment="Center" />
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowConversionOptions}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <CheckBox Content="识别特征与草图"
                              Margin="{DynamicResource Aurora.Space.Gap}"
                              IsChecked="{Binding RecognizeFeatures}"
                              ToolTip="识别特征，并对识别出的草图执行完全定义。" />
                    <CheckBox Content="失败继续"
                              Margin="{DynamicResource Aurora.Space.Gap}"
                              IsChecked="{Binding ContinueWhenPartFails}"
                              IsEnabled="{Binding CanContinueWhenPartFails}"
                              ToolTip="单个零件失败时继续转换其余零件。" />
                    <CheckBox Content="重建装配关系"
                              Margin="{DynamicResource Aurora.Space.Gap}"
                              IsChecked="{Binding RebuildMates}"
                              IsEnabled="{Binding CanRebuildMates}"
                              ToolTip="{Binding RebuildMatesHint}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRenameMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock x:Name="DrawingPrefixLabelText"
                               Style="{DynamicResource Aurora.Text.Body}"
                               FontWeight="SemiBold"
                               Margin="{DynamicResource Aurora.Space.Gap}"
                               Text="图号前缀"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="DrawingPrefixBox"
                             MinWidth="120"
                             Margin="{DynamicResource Aurora.Space.Gap}"
                             VerticalAlignment="Center"
                             Text="{Binding DrawingPrefix, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEdit}"
                             ToolTip="手写前缀，例如 ZS-LHL；后面的层级数字按所选装配体自动生成。留空＝删掉图号，文件名只剩名称。" />
                </StackPanel>
            </WrapPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="ConvertButton"
                        MinWidth="128"
                        MinHeight="{DynamicResource Aurora.Size.Control}"
                        Margin="{DynamicResource Aurora.Space.Gap}"
                        Style="{DynamicResource Aurora.Button.Accent}"
                        Content="{Binding PrimaryActionText}"
                        Click="OnConvertClick"
                        IsEnabled="{Binding CanConvert}"
                        VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
