<UserControl x:Class="HistoryMinerva.AssemblyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HistoryMinerva"
             MinWidth="320"
             MinHeight="320"
             Background="Transparent"
             FontFamily="{DynamicResource Shell.Font.Family}"
             FontSize="{DynamicResource Shell.Font.Body}"
             Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <UserControl.Resources>
        <Style x:Key="Mapping.DataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Shell.Brush.SurfaceAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Shell.Brush.Hairline}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontFamily" Value="{DynamicResource Shell.Font.Family}" />
            <Setter Property="FontSize" Value="{DynamicResource Shell.Font.Body}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="{DynamicResource Shell.Space.ControlPad}" />
            <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Control}" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:AssemblyTreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding SourcePath}">
                <TextBlock Style="{DynamicResource Shell.Text.Body}"
                           Text="{Binding DisplayName}"
                           FontWeight="SemiBold" />
                <TextBlock Style="{DynamicResource Shell.Text.Caption}"
                           Text="{Binding StateText, StringFormat=  · {0}}" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="OutputPathBar"
                Grid.Row="0"
                Margin="{DynamicResource Shell.Space.PadTight}"
                MinHeight="{DynamicResource Shell.Size.Tab}"
                Background="{DynamicResource Shell.Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Shell.Radius.Inner}"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SourceColumn" Width="*" />
                    <ColumnDefinition x:Name="ContentColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="SourceSelectorButton"
                        Padding="{DynamicResource Shell.Space.ControlPad}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        Click="OnChooseSourceClick"
                        ToolTip="点击选择装配体或零件文件夹">
                    <Button.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="取消当前操作"
                                      Click="OnCancelClick"
                                      IsEnabled="{Binding CanCancel}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SourceLabelText"
                                   Style="{DynamicResource Shell.Text.Body}"
                                   FontWeight="SemiBold"
                                   Text="{Binding SourceLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SourcePathText"
                                   Grid.Column="1"
                                   Style="{DynamicResource Shell.Text.Body}"
                                   Margin="{DynamicResource Shell.Space.Gap}"
                                   Text="{Binding SourcePath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SourcePath}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <Border Grid.Column="1"
                        Padding="{DynamicResource Shell.Space.ControlPad}"
                        BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ContentLabelText"
                                   Style="{DynamicResource Shell.Text.Body}"
                                   FontWeight="SemiBold"
                                   Text="转换内容"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="MappingContentSelector"
                                  Grid.Column="1"
                                  Margin="{DynamicResource Shell.Space.Gap}"
                                  ItemsSource="{Binding MappingContents}"
                                  SelectedItem="{Binding SelectedMappingContent, Mode=TwoWay}"
                                  ToolTip="选择来源内容与目标文件类型"
                                  IsEnabled="{Binding CanEdit}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <ProgressBar x:Name="OutputActivityBar"
                             Grid.ColumnSpan="2"
                             Height="3"
                             VerticalAlignment="Bottom"
                             IsIndeterminate="True"
                             Background="{DynamicResource Shell.Brush.Hairline}"
                             Foreground="{DynamicResource Shell.Brush.Accent}"
                             IsHitTestVisible="False">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="{DynamicResource Shell.Space.PadTight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="2*" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPartDirectoryMode}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Shell.Brush.Surface}"
                    BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Shell.Radius.Inner}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPartDirectoryMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Padding="{DynamicResource Shell.Space.PadTight}"
                            Background="{DynamicResource Shell.Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Style="{DynamicResource Shell.Text.Body}"
                                   Text="装配结构"
                                   FontWeight="SemiBold" />
                    </Border>
                    <TreeView ItemsSource="{Binding AssemblyTree}"
                              Padding="{DynamicResource Shell.Space.PadTight}"
                              Background="Transparent"
                              Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                              BorderThickness="0" />
                </DockPanel>
            </Border>

            <Border Background="{DynamicResource Shell.Brush.Surface}"
                    BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Shell.Radius.Inner}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="1" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Setter Property="Margin" Value="4,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPartDirectoryMode}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DataGrid x:Name="PartsDataGrid"
                          ItemsSource="{Binding Parts}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="{DynamicResource Shell.Brush.Surface}"
                          Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                          RowBackground="{DynamicResource Shell.Brush.Surface}"
                          AlternatingRowBackground="{DynamicResource Shell.Brush.SurfaceAlt}"
                          HorizontalGridLinesBrush="{DynamicResource Shell.Brush.Hairline}"
                          BorderThickness="0"
                          RowHeight="32"
                          ColumnHeaderHeight="28"
                          ColumnHeaderStyle="{StaticResource Mapping.DataGridHeader}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Solid Edge 零件" Binding="{Binding FileName}" Width="2*" MinWidth="120" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="72" />
                        <DataGridTextColumn Header="特征" Binding="{Binding FeatureText}" Width="58" />
                        <DataGridTextColumn Header="草图" Binding="{Binding SketchText}" Width="58" />
                        <DataGridTextColumn Header="结果" Binding="{Binding Detail}" Width="2.4*" MinWidth="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Grid x:Name="OptionsActionBar"
              Grid.Row="2"
              Margin="{DynamicResource Shell.Space.PadTight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <WrapPanel x:Name="OptionsList"
                       Orientation="Horizontal"
                       VerticalAlignment="Center">
                <TextBlock x:Name="OptionsLabelText"
                           Style="{DynamicResource Shell.Text.Body}"
                           FontWeight="SemiBold"
                           Margin="{DynamicResource Shell.Space.Gap}"
                           Text="转换选项"
                           VerticalAlignment="Center" />
                <CheckBox Content="识别特征"
                          Margin="{DynamicResource Shell.Space.Gap}"
                          IsChecked="{Binding RecognizeFeatures}" />
                <CheckBox Content="完全定义草图"
                          Margin="{DynamicResource Shell.Space.Gap}"
                          IsChecked="{Binding FullyDefineSketches}"
                          IsEnabled="{Binding CanFullyDefineSketches}" />
                <CheckBox Content="零件失败时继续"
                          Margin="{DynamicResource Shell.Space.Gap}"
                          IsChecked="{Binding ContinueWhenPartFails}"
                          IsEnabled="{Binding CanContinueWhenPartFails}" />
                <CheckBox Content="重建装配关系"
                          Margin="{DynamicResource Shell.Space.Gap}"
                          IsChecked="{Binding RebuildMates}"
                          IsEnabled="{Binding CanRebuildMates}"
                          ToolTip="{Binding RebuildMatesHint}" />
            </WrapPanel>
            <Button x:Name="ConvertButton"
                    Grid.Column="1"
                    MinWidth="128"
                    MinHeight="{DynamicResource Shell.Size.Control}"
                    Margin="{DynamicResource Shell.Space.Gap}"
                    Style="{DynamicResource Shell.Button.Accent}"
                    Content="{Binding PrimaryActionText}"
                    Click="OnConvertClick"
                    IsEnabled="{Binding CanConvert}"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
