<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\HistoryMinerva.Version.props" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HistoryMinerva.Smoke" />
    <InternalsVisibleTo Include="HistoryMinerva.UiSmoke" />
    <ProjectReference Include="..\HistoryMinerva.Contracts\HistoryMinerva.Contracts.csproj" />
    <ProjectReference Include="..\HistoryMinerva.Worker\HistoryMinerva.Worker.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="HistoryVulcan.Core">
      <HintPath>$(HistoryVulcanCorePath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="ValidateHistoryVulcanSnapshot" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(HistoryVulcanManifestPath)')" Text="HistoryVulcan manifest not found: $(HistoryVulcanManifestPath)" />
    <Error Condition="!Exists('$(HistoryVulcanCorePath)')" Text="HistoryVulcan.Core not found: $(HistoryVulcanCorePath)" />
    <GetAssemblyIdentity AssemblyFiles="$(HistoryVulcanCorePath)">
      <Output TaskParameter="Assemblies" ItemName="_HistoryVulcanCoreIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="'%(_HistoryVulcanCoreIdentity.Version)' != '$(HistoryVulcanVersion).0'"
           Text="HistoryVulcan.Core version mismatch. Expected=$(HistoryVulcanVersion).0 Actual=%(_HistoryVulcanCoreIdentity.Version)" />
  </Target>
  <Target Name="CopyWorkerArtifacts" AfterTargets="Build">
    <ItemGroup>
      <WorkerArtifact Include="..\HistoryMinerva.Worker\bin\$(Configuration)\net8.0-windows\win-x64\HistoryMinerva.Worker.exe" />
      <WorkerArtifact Include="..\HistoryMinerva.Worker\bin\$(Configuration)\net8.0-windows\win-x64\HistoryMinerva.Worker.dll" />
      <WorkerArtifact Include="..\HistoryMinerva.Worker\bin\$(Configuration)\net8.0-windows\win-x64\HistoryMinerva.Worker.deps.json" />
      <WorkerArtifact Include="..\HistoryMinerva.Worker\bin\$(Configuration)\net8.0-windows\win-x64\HistoryMinerva.Worker.runtimeconfig.json" />
      <WorkerArtifact Include="..\HistoryMinerva.Worker\bin\$(Configuration)\net8.0-windows\win-x64\HistoryMinerva.Api.dll" />
      <WorkerArtifact Include="..\HistoryMinerva.Worker\bin\$(Configuration)\net8.0-windows\win-x64\Microsoft.CodeAnalysis.dll" />
      <WorkerArtifact Include="..\HistoryMinerva.Worker\bin\$(Configuration)\net8.0-windows\win-x64\Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerArtifact)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
