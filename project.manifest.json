        "HistoryMinerva.xml",
        "HistoryMinerva.Contracts.dll",
        "HistoryMinerva.Contracts.xml",
        "HistoryMinerva.Worker.exe",
        "HistoryMinerva.Worker.dll",
        "HistoryMinerva.Worker.deps.json",
        "HistoryMinerva.Worker.runtimeconfig.json",
        "module.manifest.json"
      ]
    },
    "validation": [
      {
        "tool": "dotnet.exe",
        "configurations": [
          "Release"
        ],
        "arguments": [
          "run",
          "--project",
          "b-Code-HistoryMinerva-Tests\\tests\\HistoryMinerva.Smoke\\HistoryMinerva.Smoke.csproj",
          "-c",
          "{configuration}",
          "-p:NuGetAudit=false",
          "-p:BaseOutputPath={isolatedOutputRoot}"
        ],
        "description": "Run module Smoke",
        "isolatedOutputRoot": "b-Code-HistoryMinerva-Tests\\tests\\HistoryMinerva.Smoke\\isolated"
      },
      {
        "tool": "dotnet.exe",
        "configurations": [
          "Release"
        ],
        "arguments": [
          "run",
          "--project",
          "b-Code-HistoryMinerva-Tests\\tests\\HistoryMinerva.UiSmoke\\HistoryMinerva.UiSmoke.csproj",
          "-c",
          "{configuration}",
          "-p:NuGetAudit=false",
          "-p:BaseOutputPath={isolatedOutputRoot}",
          "--",
          "--width",
          "320",
          "--height",
          "680",
          "--dark",
          "--capture",
          "{capturePath}"
        ],
        "description": "Run module UI Smoke",
        "isolatedOutputRoot": "b-Code-HistoryMinerva-Tests\\tests\\HistoryMinerva.UiSmoke\\isolated"
      }
