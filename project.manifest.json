    "setup": "dotnet restore .\\HistoryMinerva.sln --locked-mode -p:NuGetAudit=false",
    "build": "dotnet build .\\HistoryMinerva.sln -c Release --no-restore -warnaserror -p:NuGetAudit=false",
    "test": "dotnet run --project .\\b-Code-HistoryMinerva-Tests\\tests\\HistoryMinerva.Smoke\\HistoryMinerva.Smoke.csproj -c Release -p:NuGetAudit=false",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code-HistoryMinerva\\eng\\Test-QualityGate.ps1",
    "run": null,
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\b-Code-HistoryMinerva\\eng\\Build-HistoryMinervaPackage.ps1"
  },
  "externalDependencies": [
    ".NET 8 SDK and Windows Desktop Runtime",
    "HistoryVulcan.Core 6.0.0 or newer host snapshot (minimum compatible host version)",
    "HistoryAurora 1.0.0 Release runtime (UI Smoke theme fixture only)",
    "HistoryApollo 0.2.0 or newer, optional: purchased-part brand lookup over the command bus (apollo.chat.ask web=true)",
    "Solid Edge 2020 COM automation",
    "SolidWorks 2025 SP5 COM automation",
    "SolidWorks FeatureWorks"
  ],
  "contextExclusions": [
    "z-Publish/**",
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "**/.vs/**",
    "artifacts/**"
  ],
  "publish": {
